    {
      "parameters": {
        "jsCode": "const brl = (v) => 'R$ ' + Number(v).toFixed(2).replace('.', ',');\nconst b = $input.first().json.body || {};\nif (b.token !== $('Config').first().json.app_token) throw new Error('Token do app inválido');\nconst itens = Array.isArray(b.itens) ? b.itens : [];\nif (!itens.length) throw new Error('Pedido sem itens');\nconst total = itens.reduce((s, i) => s + Number(i.preco || 0), 0);\n\nlet telefone = String((b.cliente && b.cliente.telefone) || '').replace(/\\D/g, '');\nif (telefone.length < 10) throw new Error('Telefone do cliente inválido');\nif (!telefone.startsWith('55')) telefone = '55' + telefone;\n\nconst pagamento = String(b.pagamento || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');\nif (!['pix', 'cartao', 'dinheiro'].includes(pagamento)) throw new Error('Forma de pagamento inválida');\n\nconst troco = b.troco_para ? Number(String(b.troco_para).replace(',', '.')) : null;\nconst lista = itens.map((i) => `• ${i.nome}${i.detalhe ? ' (' + i.detalhe + ')' : ''} — ${brl(i.preco)}`).join('\\n');\n\nreturn [{ json: {\n  nome: (b.cliente && b.cliente.nome) || 'Cliente',\n  telefone,\n  endereco: b.endereco || '',\n  observacoes: String(b.observacoes || '').slice(0, 300),\n  pagamento,\n  troco_para: troco,\n  itens,\n  total,\n  lista,\n} }];\n"
      },
      "id": "ae29c717-ead1-492b-8f1c-7666a8bb7041",
      "name": "Montar pedido",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO pedidos (cliente_nome, cliente_telefone, endereco, itens, total, pagamento, troco_para, pix_status, observacoes)\nVALUES ($1, $2, $3, $4::jsonb, $5::numeric, $6, NULLIF($7, '')::numeric, NULLIF($8, ''), $9)\nRETURNING id;",
        "options": {
          "queryReplacement": "={{ [ $json.nome, $json.telefone, $json.endereco, JSON.stringify($json.itens), $json.total, $json.pagamento, $json.troco_para == null ? '' : String($json.troco_para), $json.pagamento === 'pix' ? 'aguardando' : '', $json.observacoes ] }}"
        }
      },
      "id": "11163a28-12db-4c9f-8db3-f13be75398f5",
      "name": "Salvar pedido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, pedido_id: $json.id }) }}",
        "options": {}
      },
      "id": "d1148d53-fc09-411b-ba0e-6b22c7892bbc",
      "name": "Responder app",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const brl = (v) => 'R$ ' + Number(v).toFixed(2).replace('.', ',');\nconst p = $('Montar pedido').first().json;\nconst id = $('Salvar pedido').first().json.id;\nconst cfg = $('Config').first().json;\n\nconst pagto = {\n  pix: 'Pix (aguardando comprovante)',\n  cartao: 'Cartão na entrega (levar maquininha)',\n  dinheiro: 'Dinheiro' + (p.troco_para ? ` (troco para ${brl(p.troco_para)})` : ' (sem troco)'),\n}[p.pagamento];\n\nconst cozinha = `*NOVO PEDIDO #${id}*\\n` +\n  `Cliente: ${p.nome} (${p.telefone})\\n` +\n  `Endereço: ${p.endereco}\\n\\n` +\n  `${p.lista}\\n\\n` +\n  (p.observacoes ? `Obs.: ${p.observacoes}\\n\\n` : '') +\n  `*Total: ${brl(p.total)}*\\n` +\n  `Pagamento: ${pagto}`;\n\nlet cliente = `Olá, ${p.nome}! Recebemos seu pedido *#${id}* na Naturalle Mania.\\n\\n${p.lista}\\n\\n*Total: ${brl(p.total)}*\\n\\n`;\nif (p.pagamento === 'pix') {\n  cliente += `Para pagar via Pix, use a chave:\\n*${cfg.pix_chave}*\\n(${cfg.pix_nome})\\n\\nDepois é só responder aqui com a foto do comprovante.`;\n} else if (p.pagamento === 'cartao') {\n  cliente += 'Pagamento no cartão na entrega: o entregador leva a maquininha.';\n} else {\n  cliente += 'Pagamento em dinheiro na entrega' + (p.troco_para ? `, troco para ${brl(p.troco_para)}.` : '.');\n}\ncliente += '\\n\\nVamos te avisando por aqui a cada etapa!';\n\nreturn [{ json: { id, telefone: p.telefone, cozinha, cliente } }];\n"
      },
      "id": "b8e85216-8a7e-4ef2-b08a-25868954ccce",
