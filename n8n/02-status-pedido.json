      "id": "71bff8a8-5a97-4cba-aef5-be69a89de8a3",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst cfg = $('Config').first().json;\nif (b.token !== cfg.painel_token) throw new Error('Token do painel inválido');\nconst validos = ['preparo', 'saiu', 'entregue', 'cancelado'];\nif (!validos.includes(b.status)) throw new Error('Status inválido');\nconst id = parseInt(b.pedido_id, 10);\nif (!id) throw new Error('pedido_id inválido');\nreturn [{ json: { id, status: b.status } }];\n"
      },
      "id": "8257000f-bfc8-4502-8e7b-78265544d2c0",
      "name": "Validar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pedidos SET status = $1, atualizado_em = now() WHERE id = $2::int\nRETURNING id, status, cliente_nome, cliente_telefone;",
        "options": {
          "queryReplacement": "={{ [ $json.status, $json.id ] }}"
        }
      },
      "id": "f2ad8c76-1b9e-433b-91c5-a745bcf44b2d",
      "name": "Atualizar status",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $input.first().json;\nif (!p.id) throw new Error('Pedido não encontrado');\nconst textos = {\n  preparo: `Seu pedido *#${p.id}* já está sendo preparado!`,\n  saiu: `Seu pedido *#${p.id}* saiu para entrega! Já já chega aí.`,\n  entregue: `Pedido *#${p.id}* entregue. Obrigado, ${p.cliente_nome}! Bom apetite e volte sempre à Naturalle Mania.`,\n  cancelado: `Seu pedido *#${p.id}* foi cancelado. Qualquer dúvida, é só responder aqui.`,\n};\nreturn [{ json: { id: p.id, status: p.status, telefone: p.cliente_telefone, texto: textos[p.status] } }];\n"
      },
      "id": "a0348c6d-d4d5-4568-955c-410904905045",
      "name": "Mensagem do status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.evolution_url }}/message/sendText/{{ $('Config').item.json.evolution_instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').item.json.evolution_apikey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Mensagem do status').item.json.telefone, text: $('Mensagem do status').item.json.texto }) }}",
        "options": {}
      },
      "id": "9c00a54d-252a-4156-a219-f45f33080cfc",
      "name": "Avisar cliente",
