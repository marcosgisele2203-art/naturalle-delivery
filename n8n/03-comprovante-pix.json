      "id": "13032e56-d8e3-4be2-a69a-043526ff8e55",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst d = b.data || {};\nconst key = d.key || {};\n// o WhatsApp às vezes manda um \"@lid\" no remoteJid e o número de verdade em outro campo\nconst jids = [key.remoteJid, key.remoteJidAlt, key.senderPn, d.senderPn].filter(Boolean);\nconst jid = jids.find((j) => j.endsWith('@s.whatsapp.net')) || '';\nif (b.event !== 'messages.upsert' || key.fromMe || !jid) return [];\nconst tipo = d.messageType || Object.keys(d.message || {})[0] || '';\nif (!['imageMessage', 'documentMessage'].includes(tipo)) return [];\nconst telefone = jid.split('@')[0];\n// Compara pelos 8 últimos dígitos: o WhatsApp pode tirar o 9 extra do celular.\nreturn [{ json: { telefone, final8: telefone.slice(-8) } }];\n"
      },
      "id": "a05ef78d-35d8-4c21-883b-e7251ef21384",
      "name": "Filtrar comprovante",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pedidos SET pix_status = 'comprovante_recebido', atualizado_em = now()\nWHERE id = (\n  SELECT id FROM pedidos\n  WHERE right(cliente_telefone, 8) = $1 AND pagamento = 'pix' AND pix_status = 'aguardando'\n  ORDER BY criado_em DESC LIMIT 1\n)\nRETURNING id, cliente_nome, cliente_telefone, total;",
        "options": {
          "queryReplacement": "={{ [ $json.final8 ] }}"
        }
      },
      "id": "ca219a9c-c1e4-4c8f-b124-061a8592a8d5",
      "name": "Marcar comprovante",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const brl = (v) => 'R$ ' + Number(v).toFixed(2).replace('.', ',');\nconst p = $input.first().json;\nif (!p.id) return []; // nenhum pedido Pix aguardando para esse número\nconst cfg = $('Config').first().json;\nconst saida = [{ numero: p.cliente_telefone, texto: `Recebemos seu comprovante do pedido *#${p.id}*! Assim que conferirmos, seu pedido segue.` }];\nif (cfg.numero_loja) saida.push({ numero: cfg.numero_loja,\n  texto: `*Comprovante Pix recebido* do pedido #${p.id} (${p.cliente_nome}, ${brl(p.total)}). Confira e clique em \"Confirmar Pix\" no painel.` });\nreturn saida.map((json) => ({ json }));\n"
      },
      "id": "eda4e552-175e-4702-ab1f-bce69378d847",
      "name": "Montar avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.evolution_url }}/message/{{ $json.copiar ? 'sendButtons' : 'sendText' }}/{{ $('Config').first().json.evolution_instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.evolution_apikey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.copiar ? { number: $json.numero, title: 'Pix copia e cola', description: $json.texto, footer: 'Naturalle Mania', buttons: [{ type: 'copy', displayText: 'Copiar código Pix', copyCode: $json.copiar }] } : { number: $json.numero, text: $json.texto }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 1500
            }
          }
        }
      },
      "id": "54ba89a3-7b20-4794-bd72-bc688169e49c",
      "name": "Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        300
      ],
      "onError": "continueRegularOutput"
    }
  ],
