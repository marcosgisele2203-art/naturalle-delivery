        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst d = b.data || {};\nconst key = d.key || {};\nconst jid = key.remoteJid || '';\nif (b.event !== 'messages.upsert' || key.fromMe || !jid.endsWith('@s.whatsapp.net')) return [];\nconst tipo = d.messageType || Object.keys(d.message || {})[0] || '';\nif (!['imageMessage', 'documentMessage'].includes(tipo)) return [];\nconst telefone = jid.split('@')[0];\n// Compara pelos 8 últimos dígitos: o WhatsApp pode tirar o 9 extra do celular.\nreturn [{ json: { telefone, final8: telefone.slice(-8) } }];\n"
      },
      "id": "4449395f-fc8b-4651-9cf1-86f547d2e3ab",
      "name": "Filtrar comprovante",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pedidos SET pix_status = 'comprovante_recebido', atualizado_em = now()\nWHERE id = (\n  SELECT id FROM pedidos\n  WHERE right(cliente_telefone, 8) = $1 AND pagamento = 'pix' AND pix_status = 'aguardando'\n  ORDER BY criado_em DESC LIMIT 1\n)\nRETURNING id, cliente_nome, cliente_telefone, total;",
        "options": {
          "queryReplacement": "={{ [ $json.final8 ] }}"
        }
      },
      "id": "800837f2-07da-40b8-b785-99e4d1a218d3",
      "name": "Marcar comprovante",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const brl = (v) => 'R$ ' + Number(v).toFixed(2).replace('.', ',');\nconst p = $input.first().json;\nif (!p.id) return []; // nenhum pedido Pix aguardando para esse número\nreturn [{ json: {\n  telefone: p.cliente_telefone,\n  cozinha: `*Comprovante Pix recebido* do pedido #${p.id} (${p.cliente_nome}, ${brl(p.total)}). Confira no WhatsApp ${p.cliente_telefone} antes de liberar.`,\n  cliente: `Recebemos seu comprovante do pedido *#${p.id}*! Assim que conferirmos, seu pedido vai para o preparo.`,\n} }];\n"
      },
      "id": "44656265-6834-403a-a48f-1c719f10ae91",
      "name": "Montar avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').item.json.evolution_url }}/message/sendText/{{ $('Config').item.json.evolution_instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').item.json.evolution_apikey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $('Config').item.json.numero_cozinha, text: $('Montar avisos').item.json.cozinha }) }}",
        "options": {}
      },
      "id": "b8c24d3b-3b87-4848-8222-e3212b60d795",
