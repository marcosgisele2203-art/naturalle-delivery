      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json.body || {};\nconst d = b.data || {};\nconst key = d.key || {};\nconst jid = key.remoteJid || '';\nif (b.event !== 'messages.upsert' || key.fromMe || !jid.endsWith('@s.whatsapp.net')) return [];\nconst tipo = d.messageType || Object.keys(d.message || {})[0] || '';\nif (!['imageMessage', 'documentMessage'].includes(tipo)) return [];\nconst telefone = jid.split('@')[0];\n// Compara pelos 8 últimos dígitos: o WhatsApp pode tirar o 9 extra do celular.\nreturn [{ json: { telefone, final8: telefone.slice(-8) } }];\n"
      },
      "id": "2a3578bb-11f5-4357-87de-88be5256a6e2",
      "name": "Filtrar comprovante",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE pedidos SET pix_status = 'comprovante_recebido', atualizado_em = now()\nWHERE id = (\n  SELECT id FROM pedidos\n  WHERE right(cliente_telefone, 8) = $1 AND pagamento = 'pix' AND pix_status = 'aguardando'\n  ORDER BY criado_em DESC LIMIT 1\n)\nRETURNING id, cliente_nome, cliente_telefone, total;",
        "options": {
          "queryReplacement": "={{ [ $json.final8 ] }}"
        }
      },
      "id": "3e19ffae-ef0f-4229-9510-3acf419f3691",
      "name": "Marcar comprovante",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const brl = (v) => 'R$ ' + Number(v).toFixed(2).replace('.', ',');\nconst p = $input.first().json;\nif (!p.id) return []; // nenhum pedido Pix aguardando para esse número\nconst cfg = $('Config').first().json;\nconst saida = [{ numero: p.cliente_telefone, texto: `Recebemos seu comprovante do pedido *#${p.id}*! Assim que conferirmos, seu pedido segue.` }];\nif (cfg.numero_loja) saida.push({ numero: cfg.numero_loja,\n  texto: `*Comprovante Pix recebido* do pedido #${p.id} (${p.cliente_nome}, ${brl(p.total)}). Confira e clique em \"Confirmar Pix\" no painel.` });\nreturn saida.map((json) => ({ json }));\n"
      },
      "id": "7091b90b-925d-450f-a0cb-e4b3a7158665",
      "name": "Montar avisos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.evolution_url }}/message/sendText/{{ $('Config').first().json.evolution_instance }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Config').first().json.evolution_apikey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ number: $json.numero, text: $json.texto }) }}",
        "options": {}
      },
      "id": "909991da-b92e-42fe-91af-054a9cb609f2",
